if SHIELD_seat_LEFT

config ZMK_KEYBOARD_NAME
    default "seat"

config ZMK_SPLIT_ROLE_CENTRAL
    default y


endif

if SHIELD_seat_RIGHT

config ZMK_KEYBOARD_NAME
    default "seat Right"

endif

if SHIELD_seat_LEFT || SHIELD_seat_RIGHT

config ZMK_SPLIT
    default y

endif