 #include <dt-bindings/zmk/matrix_transform.h>
 #include "trackball.dtsi"

 / {
     chosen {
         zmk,kscan = &kscan0;
         zmk,matrix-transform = &default_transform;
         /delete-property/ zephyr,console;
         /delete-property/ zephyr,shell-uart;
     };
    
     pro_micro_kc: connector {
         compatible = "arduino-pro-micro";
         #gpio-cells = <2>;
         gpio-map-mask = <0xffffffff 0xffffffc0>;
         gpio-map-pass-thru = <0 0x3f>;
         gpio-map
            = <0 0 &gpio0 6 0>      /* D0 */
            , <1 0 &gpio0 8 0>      /* D1 */
            , <2 0 &gpio0 17 0>     /* D2 */
            , <3 0 &gpio0 20 0>     /* D3 */
            , <4 0 &gpio0 22 0>     /* D4/A6 */
            , <5 0 &gpio0 24 0>     /* D5 */
            , <6 0 &gpio1 0 0>      /* D6/A7 */
            , <7 0 &gpio0 11 0>     /* D7 */
            , <8 0 &gpio1 4 0>      /* D8/A8 */
            , <9 0 &gpio1 6 0>      /* D9/A9 */
            , <10 0 &gpio0 9 0>     /* D10/A10 */
            , <11 0 &gpio0 10 0>    /* D11 */
            , <12 0 &gpio1 11 0>    /* D12 */
            , <13 0 &gpio1 13 0>    /* D13 */
            , <14 0 &gpio1 15 0>    /* D14 */
            , <15 0 &gpio0 2 0>    /* D15 */
            , <16 0 &gpio0 29 0>    /* D16 */
            , <17 0 &gpio0 31 0>    /* D17 */
            , <18 0 &gpio1 1 0>    /* D18/A0 */
            , <19 0 &gpio1 2 0> /* D19/A1 */
            , <20 0 &gpio1 7 0>    /* D20/A2 */
            ;
     };
 
     default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                 RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                 RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                 RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)                 RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                        RC(4,4) RC(4,3) RC(4,2)                 RC(4,9) RC(4,8) RC(4,7)
                                RC(4,5) RC(4,1)                 RC(4,10) RC(4,6) 
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        wakeup-source;
        diode-direction = "row2col"; 
    };
};